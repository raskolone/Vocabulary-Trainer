{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CRIBRO ENGLISH",
  "version": "0.1.0",
  "identifier": "pro.maciej.cribro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CRIBRO ENGLISH",
        "url": "http://localhost:3000",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "visible": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Maciej Wyrozumski",
    "category": "Education",
    "shortDescription": "CRIBRO ENGLISH",
    "longDescription": "Panel lektora i kursanta CRIBRO ENGLISH jako aplikacja desktopowa."
  }
}
